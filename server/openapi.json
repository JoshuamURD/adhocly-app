                "$ref": "#/components/schemas/ProjectFolderInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Project filed into the folder, or at the top level when folderId is null",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "description": "Inbox cannot be filed",
