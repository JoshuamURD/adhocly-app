    "/api/folders": {
      "get": {
        "tags": [
          "folders"
        ],
        "operationId": "listFolders",
        "responses": {
          "200": {
            "description": "Every folder, flat; `parentId` carries the nesting",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Folder"
                  }
                }
              }
