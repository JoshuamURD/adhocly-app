  "components": {
    "schemas": {
      "BTreeMap": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "format": "int64"
        },
        "propertyNames": {
          "type": "string"
        }
      },
      "FieldKind": {
        "type": "string",
        "enum": [
          "text",
          "number",
          "choice"
        ]
      },
      "Folder": {
        "type": "object",
        "required": [
          "id",
          "name",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "`None` is the top level; folders nest to any depth."
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "FolderInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional client-selected entity id; sync uses a separate mutation id for safe replay."
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Omitted or null creates/moves the folder at the top level."
          }
        }
      },
      "MetadataField": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "options",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/FieldKind"
          },
          "name": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MetadataFieldInput": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional client-selected entity id; sync uses a separate mutation id for safe replay."
          },
          "kind": {
