    "/api/sync": {
      "get": {
        "tags": [
          "sync"
        ],
        "operationId": "getSyncSnapshot",
        "responses": {
          "200": {
            "description": "Atomic server snapshot and entity revisions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncSnapshot"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "sync"
        ],
        "operationId": "applySyncOperation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncOperation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Committed or previously committed mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncReply"
                }
              }
            }
          },
          "400": {
            "description": "Invalid mutation",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Entity not found",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Revision or mutation id conflict",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
